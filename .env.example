# ==============================================================================
# SkillGraph Environment Configuration Template
# ==============================================================================
# Out of the box, SkillGraph runs locally with zero external configuration 
# (SQLite database and deterministic Mock AI provider require no API keys).
#
# Backend Configuration (apps/api/.env):
APP_NAME=SkillGraph API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./skillgraph.db
JWT_SECRET=skillgraph-development-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:3000"]
AI_PROVIDER=mock
RATE_LIMIT_PER_MINUTE=120

# Optional External AI Providers (Set AI_PROVIDER to anthropic, openai, or google):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Frontend Configuration (apps/web/.env.local):
NEXT_PUBLIC_API_URL=http://localhost:8000
