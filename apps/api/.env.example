# Copy to .env and adjust as needed. The app runs fully without any of these set.

APP_NAME=SkillGraph API
ENVIRONMENT=development

# Defaults to a local SQLite file if unset. Point at Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://skillgraph:skillgraph@localhost:5432/skillgraph
DATABASE_URL=

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=["http://localhost:3000"]

# mock | anthropic | openai | google. "mock" (default) requires no API key.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

RATE_LIMIT_PER_MINUTE=120
